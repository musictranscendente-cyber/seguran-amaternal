rules_version = '2';

// Modelo:
//   familias/{familiaId}  -> { ownerUid, nome }
//     criancas/{criancaId} -> { nome, childUid, ultimaLocalizacao, escutaAtiva }
//       historico/{id}, comandos/{id}, audio/{id}
//   pareamentos/{codigo}  -> { familiaId, criancaId, ownerUid, expiraEm, usado }
//
// Responsável (dono, autenticado por e-mail/senha) tem acesso total à sua família.
// Aparelho da criança (autenticado anônimo) só acessa a criança que reivindicou.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function familia(familiaId) {
      return get(/databases/$(database)/documents/familias/$(familiaId)).data;
    }

    // Código de pareamento: o responsável cria, o aparelho da criança lê uma vez.
    match /pareamentos/{codigo} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn()
        && request.resource.data.ownerUid == uid();
      allow update: if signedIn(); // permite marcar "usado: true" ao vincular
    }

    match /familias/{familiaId} {
      function isOwner() {
        return signedIn() && resource.data.ownerUid == uid();
      }

      allow create: if signedIn() && request.resource.data.ownerUid == uid();
      allow read, update, delete: if isOwner();

      match /criancas/{criancaId} {
        function donoDaFamilia() {
          return signedIn() && familia(familiaId).ownerUid == uid();
        }
        function ehACrianca() {
          return signedIn() && resource.data.childUid == uid();
        }
        // Reivindicação: um aparelho sem dono ainda pode se registrar.
        function reivindicando() {
          return signedIn()
            && resource.data.childUid == null
            && request.resource.data.childUid == uid();
        }

        allow read: if donoDaFamilia() || ehACrianca();
        allow create, delete: if donoDaFamilia();
        allow update: if donoDaFamilia() || ehACrianca() || reivindicando();

        // Subcoleções: dono ou a própria criança.
        match /{sub=**} {
          allow read, write: if donoDaFamilia()
            || (signedIn()
                && get(/databases/$(database)/documents/familias/$(familiaId)/criancas/$(criancaId)).data.childUid == uid());
        }
      }
    }
  }
}
